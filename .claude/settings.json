{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(curl -s https://christophe-dev-freelance.fr*)",
      "Bash(curl -sI https://christophe-dev-freelance.fr*)",
      "Bash(curl -s -o /dev/null *)",
      "Bash(gh run watch *)",
      "Bash(gh run list *)",
      "Bash(npm run build)",
      "Bash(bash scripts/optimize-images.sh)",
      "Bash(sips *)",
      "mcp__chrome-devtools__lighthouse_audit",
      "mcp__chrome-devtools__new_page"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/seo-guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
